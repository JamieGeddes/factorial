{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:factorial:contracts:progress:v1",
  "title": "WorkItemProgress",
  "description": "One stage transition of a work item, or its end: the detail of a WorkItemProgress event (source factorial.progress) on the factorial-work bus. Emitted only by the orchestrator (its Lambdas and the invoker), after the same transition is recorded on the ledger row. At least once: every copy of a transition carries the same eventId. Metadata only, never content. Internal to Factorial, not part of the WorkItem API.",
  "type": "object",
  "additionalProperties": false,
  "required": ["schemaVersion", "eventId", "workItemId", "source", "repository", "stage", "transition", "at"],
  "properties": {
    "schemaVersion": {
      "description": "Version of this contract. Incremented only for breaking changes.",
      "const": 1
    },
    "eventId": {
      "description": "<workItemId>:<stage key>:<transition>, the same for every copy of one transition, so a subscriber can drop repeats.",
      "type": "string",
      "pattern": "^[0-9a-f-]{36}:[A-Za-z]+(#[0-9]+)?:(started|succeeded|failed|ended)$"
    },
    "workItemId": { "type": "string", "format": "uuid" },
    "attempt": { "type": "integer", "minimum": 1 },
    "threadKey": { "description": "The thread, <owner>/<name>#<branch>, once Intake has found it.", "type": "string", "minLength": 1 },
    "source": {
      "description": "The WorkItem's source, so a subscriber can act per trigger type without reading the ledger.",
      "type": "object",
      "additionalProperties": false,
      "required": ["type", "url"],
      "properties": {
        "type": { "type": "string", "pattern": "^[a-z][a-z0-9]*(-[a-z0-9]+)*$" },
        "url": { "type": "string", "format": "uri" }
      }
    },
    "repository": {
      "type": "object",
      "additionalProperties": false,
      "required": ["provider", "owner", "name"],
      "properties": {
        "provider": { "enum": ["github"] },
        "owner": { "type": "string", "minLength": 1 },
        "name": { "type": "string", "minLength": 1 }
      }
    },
    "stage": {
      "description": "The state machine's state name (Intake, Build, Test, ReportFailure, ...), or WorkItem for the work item's end.",
      "type": "string",
      "pattern": "^[A-Z][A-Za-z]*$",
      "maxLength": 64
    },
    "round": {
      "description": "The build round, for Build, SaveWork and ContinueBuild after the first round.",
      "type": "integer",
      "minimum": 2
    },
    "transition": { "enum": ["started", "succeeded", "failed", "ended"] },
    "at": { "description": "When the transition was recorded on the ledger.", "type": "string", "format": "date-time" },
    "status": { "description": "For ended: the ledger status the work item ended with.", "type": "string", "pattern": "^[a-z][a-z-]*$", "maxLength": 64 },
    "error": {
      "description": "For failed: the error's name and a short, redacted message.",
      "type": "object",
      "additionalProperties": false,
      "required": ["name"],
      "properties": {
        "name": { "type": "string", "minLength": 1, "maxLength": 200 },
        "message": { "type": "string", "maxLength": 1000 }
      }
    },
    "run": { "$ref": "#/$defs/run" }
  },
  "allOf": [
    { "if": { "properties": { "transition": { "const": "ended" } } }, "then": { "required": ["status"], "properties": { "stage": { "const": "WorkItem" }, "status": true, "error": false, "run": false } } },
    { "if": { "properties": { "stage": { "const": "WorkItem" } } }, "then": { "properties": { "transition": { "const": "ended" } } } },
    { "if": { "properties": { "transition": { "const": "started" } } }, "then": { "properties": { "status": false, "error": false, "run": false } } },
    { "if": { "properties": { "transition": { "enum": ["succeeded", "failed"] } } }, "then": { "properties": { "status": false } } }
  ],
  "$defs": {
    "count": { "type": "integer", "minimum": 0 },
    "run": {
      "description": "An agent run's record, on the end of Build and Review: what the run's usage.json records, as metadata.",
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "role": { "type": "string", "pattern": "^[a-z][a-z0-9-]*$" },
        "runtimeName": { "type": "string", "maxLength": 100 },
        "runtimeVersion": { "type": "string", "maxLength": 20 },
        "runContract": { "type": "integer", "minimum": 1 },
        "harness": {
          "type": "object",
          "additionalProperties": false,
          "required": ["name"],
          "properties": { "name": { "type": "string", "maxLength": 100 }, "version": { "type": "string", "maxLength": 100 } }
        },
        "modelId": { "type": "string", "maxLength": 200 },
        "effort": { "type": "string", "maxLength": 20 },
        "sessionId": { "type": "string", "maxLength": 100 },
        "toolCalls": { "$ref": "#/$defs/count" },
        "turns": { "$ref": "#/$defs/count" },
        "durationSeconds": { "$ref": "#/$defs/count" },
        "stopReason": { "type": "string", "maxLength": 100 },
        "outcome": { "enum": ["complete", "incomplete", "failed"] },
        "usage": {
          "description": "Token totals in usage.json's shape: inputTokens is the whole prompt, cache reads and writes included.",
          "type": "object",
          "additionalProperties": false,
          "required": ["inputTokens", "outputTokens"],
          "properties": {
            "modelCalls": { "$ref": "#/$defs/count" },
            "inputTokens": { "$ref": "#/$defs/count" },
            "outputTokens": { "$ref": "#/$defs/count" },
            "totalTokens": { "$ref": "#/$defs/count" },
            "cacheReadInputTokens": { "$ref": "#/$defs/count" },
            "cacheWriteInputTokens": { "$ref": "#/$defs/count" },
            "uncachedInputTokens": { "$ref": "#/$defs/count" },
            "maxCallInputTokens": { "$ref": "#/$defs/count" },
            "lastCallInputTokens": { "$ref": "#/$defs/count" }
          }
        },
        "costUsd": { "description": "The harness's estimate at list prices, not a bill.", "type": "number", "minimum": 0 },
        "transcriptKey": { "type": "string", "maxLength": 1024 },
        "usageKey": { "type": "string", "maxLength": 1024 }
      }
    }
  }
}
