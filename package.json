{
  "name": "factorial",
  "version": "0.0.0",
  "private": true,
  "description": "Factorial: a self-building software factory on AWS AgentCore",
  "type": "module",
  "engines": {
    "node": ">=22.18"
  },
  "workspaces": [
    "packages/*",
    "agent-environment/tools"
  ],
  "scripts": {
    "typecheck": "tsc --noEmit -p tsconfig.json && npm run typecheck --workspaces --if-present",
    "build": "npm run build --workspaces --if-present",
    "test": "node --disable-warning=ExperimentalWarning --test 'scripts/*.test.ts' && npm test --workspaces --if-present",
    "check:yml": "node --disable-warning=ExperimentalWarning scripts/check-yml-extension.ts",
    "lint:cfn": "cfn-lint",
    "ci": "npm run typecheck && npm run build && npm test && npm run check:yml && npm run check:workflows && npm run lint:cfn",
    "check:workflows": "node --disable-warning=ExperimentalWarning scripts/check-workflows.ts"
  },
  "devDependencies": {
    "@types/aws-lambda": "^8.10.164",
    "@types/node": "^22.19.0",
    "esbuild": "^0.28.2",
    "typescript": "^5.9.3",
    "yaml": "^2.9.1"
  }
}
